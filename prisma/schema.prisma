
generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  STAFF
  FINANCE
}

enum AssetStatus {
  PENDING_ONBOARDING
  ACTIVE
  UNDER_REPAIR
  FAULTY
  IN_STORAGE
  MISSING
  SURPLUS
  PENDING_DISPOSAL
  DISPOSED
  DONATED
  SOLD
}

enum OwnershipType {
  OWNED
  RENTED
  LEASED
  DONATED_IN
}

enum AcknowledgementStatus {
  PENDING
  ACCEPTED
}

enum DepreciationRunStatus {
  DRAFT
  POSTED
}

enum AssetRequestStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
}

enum AssetRequestUrgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANNOT_BE_REPAIRED
}

enum DisposalMethod {
  DONATED
  SOLD
  DISPOSED
}

enum DepreciationMethod {
  STRAIGHT_LINE
  DECLINING_BALANCE
  DOUBLE_DECLINING_BALANCE
  SUM_OF_YEARS_DIGITS
}

enum AssetCondition {
  NEW
  EXCELLENT
  GOOD
  FAIR
  DAMAGED
  POOR
  CRITICAL
  BEYOND_ECONOMICAL_REPAIR
  UNKNOWN
}

enum OrganizationType {
  COMMERCIAL_BANK
  RURAL_COMMUNITY_BANK
  SAVINGS_AND_LOANS
  MICROFINANCE
  INSURANCE
  FINTECH
  GOVERNMENT
  HEALTHCARE
  EDUCATION
  MANUFACTURING
  OTHER
}

enum AssignmentType {
  PERMANENT
  TEMPORARY
  SHARED
  LOANER
}

enum AcknowledgementMethod {
  CHECKBOX
  PIN
  SIGNATURE
}

enum NotFoundReason {
  UNABLE_TO_LOCATE
  EMPLOYEE_NO_LONGER_HAS_ASSET
  TRANSFERRED
  UNDER_REPAIR
  IN_STORAGE
  DISPOSED
  MISSING
  OTHER
}

enum TransferReason {
  EMPLOYEE_TRANSFER
  BRANCH_TRANSFER
  DEPARTMENT_TRANSFER
  TEMPORARY_MOVEMENT
  REPAIR
  REPLACEMENT
  STORAGE
  OTHER
}

enum RepairOutcome {
  REPAIRED
  NOT_REPAIRED
  REPLACEMENT_RECOMMENDED
  BEYOND_ECONOMICAL_REPAIR
  AWAITING_PARTS
  CANNOT_BE_REPAIRED
  OTHER
}

enum DisposalApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MovementType {
  BRANCH_TRANSFER
  STORAGE_TRANSFER
  STAFF_ASSIGNMENT
  ROOM_TRANSFER
  SHELF_TRANSFER
  DEPARTMENT_TRANSFER
}

enum DocumentType {
  RECEIPT
  INVOICE
  PURCHASE_ORDER
  WARRANTY_CARD
  MANUAL
  SERVICE_REPORT
  MAINTENANCE_INVOICE
  DISPOSAL_EVIDENCE
  OTHER
}

enum ReminderType {
  WARRANTY_EXPIRY
  REPLACEMENT_DUE
  MAINTENANCE_DUE
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum VerificationOutcome {
  VERIFIED
  NOT_FOUND
  UNREGISTERED
  EXCEPTION
}

enum ExceptionType {
  WRONG_LOCATION
  WRONG_CUSTODIAN
  MISSING
  UNREGISTERED
  DUPLICATE
  DAMAGED
  INCORRECT_SERIAL
  INCORRECT_CATEGORY
  DISPOSED_BUT_REGISTERED
  OTHER
}

enum ExceptionStatus {
  IDENTIFIED
  ASSIGNED
  INVESTIGATING
  RESOLVED
  APPROVED
  REJECTED
}

enum RecommendationState {
  HEALTHY
  APPROACHING
  OVERDUE
}

enum PermissionEffect {
  ALLOW
  DENY
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String
  emailVerified Boolean
  image         String?
  phoneNumber   String?
  role          UserRole  @default(STAFF)
  isActive      Boolean   @default(true)
  branchId      String?
  organizationId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  branch        Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  assignedAssets Asset[]   @relation("AssetCustodian")
  movementLogs  AssetMovement[] @relation("MovedByUser")
  notifications NotificationLog[]
  auditLogs     AuditLog[]
  staffProfile  StaffProfile?
  assetRequestsSubmitted AssetRequest[] @relation("AssetRequestRequester")
  assetRequestsReviewed  AssetRequest[] @relation("AssetRequestReviewer")
  assetRequestsAsCustodian AssetRequest[] @relation("AssetRequestCustodian")
  disposalRecords        AssetDisposalRecord[]
  campaignsCreated       VerificationCampaign[] @relation("CampaignCreator")
  campaignAssignments    CampaignAssignment[]
  assetVerifications     AssetVerification[]    @relation("VerifiedBy")
  exceptionsIdentified   AssetException[]       @relation("ExceptionIdentifier")
  exceptionsAssigned     AssetException[]       @relation("ExceptionAssignee")
  exceptionsApproved     AssetException[]       @relation("ExceptionApprover")
  exceptionEvents        ExceptionEvent[]
  exceptionEvidence      ExceptionEvidence[]
  acknowledgements       AssignmentAcknowledgement[]
  disposalApprovals      DisposalRecommendation[] @relation("DisposalApprover")
  healthAssessments      HealthAssessment[] @relation("HealthAssessmentCreator")
  depreciationRuns       DepreciationRun[] @relation("DepreciationRunBy")
  @@unique([email])
  @@index([branchId])
  @@index([organizationId])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("account")
}


model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
  @@index([identifier])
}

model Organization {
  id                              String                 @id @default(cuid())
  name                            String
  organizationType                OrganizationType?
  industry                        String?
  primaryContactName              String?
  contactEmail                    String?
  contactPhone                    String?
  address                         String?
  isActive                        Boolean                @default(true)
  settings                        Json?
  maintenanceCostThresholdPercent Int                    @default(50)
  createdAt                       DateTime               @default(now())
  updatedAt                       DateTime               @updatedAt
  regions                         Region[]
  branches                        Branch[]
  users                           User[]
  replacementPolicies             ReplacementPolicy[]
  depreciationPolicies            DepreciationPolicy[]
  assets                          Asset[]
  assetRequests                   AssetRequest[]
  disposalRecords                 AssetDisposalRecord[]
  campaigns                       VerificationCampaign[]
  exceptions                      AssetException[]
  healthAssessments               HealthAssessment[]
  depreciationRuns                DepreciationRun[]
  @@unique([name])
}

model Region {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branches       Branch[]
  @@unique([organizationId, name])
  @@index([organizationId])
}

model Branch {
  id             String           @id @default(cuid())
  organizationId String
  regionId       String
  name           String
  code           String
  address        String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  region         Region           @relation(fields: [regionId], references: [id], onDelete: Restrict)
  departments    Department[]
  rooms          Room[]
  users          User[]
  assets         Asset[]
  assetRequests  AssetRequest[]
  campaignAssignments CampaignAssignment[]
  @@unique([organizationId, code])
  @@index([organizationId, name])
}

model Department {
  id        String   @id @default(cuid())
  branchId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branch        Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  assets        Asset[]
  assetRequests AssetRequest[]
  @@unique([branchId, name])
}

model Room {
  id        String   @id @default(cuid())
  branchId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  shelves   Shelf[]
  assets    Asset[]
  @@unique([branchId, name])
}

model Shelf {
  id        String   @id @default(cuid())
  roomId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  assets    Asset[]
  @@unique([roomId, name])
}

model Category {
  id                    String              @id @default(cuid())
  name                  String
  replacementYears      Int
  disposalGraceMonths   Int                @default(6)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  assets                Asset[]
  replacementPolicies   ReplacementPolicy[]
  depreciationPolicies  DepreciationPolicy[]
  assetRequests         AssetRequest[]
  @@unique([name])
}

model Vendor {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assets    Asset[]
  @@unique([name])
}

model StaffProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  employeeCode String   @unique
  title        String?
  department   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Asset {
  id                    String                   @id @default(cuid())
  ain                   String
  serialNumber          String
  name                  String
  description           String?
  manufacturer          String?
  modelName             String?
  existingAssetNumber   String?
  status                AssetStatus              @default(ACTIVE)
  condition             AssetCondition           @default(GOOD)
  purchaseDate          DateTime
  purchaseCost          Decimal                  @db.Decimal(12, 2)
  warrantyExpiryDate              DateTime?
  poNumber                        String?
  invoiceNumber                   String?
  invoiceUrl                      String?
  capitalizedDate                 DateTime?
  ownershipType                   OwnershipType            @default(OWNED)
  lessorName                      String?
  leaseStartDate                  DateTime?
  leaseEndDate                    DateTime?
  leaseMonthlyCost                Decimal?                 @db.Decimal(12, 2)
  onboardingCompletedAt           DateTime?
  depreciationUsefulLifeYears     Int?
  depreciationSalvageValue        Decimal?                 @db.Decimal(12, 2)
  depreciationMethodOverride      DepreciationMethod?
  assignmentType                  AssignmentType?
  expectedReturnDate              DateTime?
  isActive                        Boolean                  @default(true)
  branchId                        String
  departmentId          String?
  roomId                String?
  shelfId               String?
  categoryId            String
  vendorId              String?
  custodianId           String?
  organizationId        String
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  branch                Branch                   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department            Department?              @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  room                  Room?                    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  shelf                 Shelf?                   @relation(fields: [shelfId], references: [id], onDelete: SetNull)
  category              Category                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  vendor                Vendor?                  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  custodian             User?                    @relation("AssetCustodian", fields: [custodianId], references: [id], onDelete: SetNull)
  organization          Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  photos                AssetPhoto[]
  documents             AssetDocument[]
  movements             AssetMovement[]
  statusHistory         AssetStatusHistory[]
  maintenanceRecords    MaintenanceRecord[]
  conditionFlags        ConditionFlag[]
  replacementEvaluations ReplacementEvaluation[]
  disposalRecommendations DisposalRecommendation[]
  disposalRecord         AssetDisposalRecord?
  fulfilledRequest       AssetRequest?
  verifications          AssetVerification[]
  exceptions             AssetException[]
  campaignSnapshots      CampaignScopeSnapshot[]
  acknowledgements       AssignmentAcknowledgement[]
  depreciationRunLines   DepreciationRunLine[]
  @@unique([ain])
  @@unique([serialNumber])
  @@index([branchId, status, updatedAt])
  @@index([custodianId])
  @@index([categoryId, purchaseDate])
  @@index([organizationId, ain])
  @@index([ownershipType])
  @@index([organizationId, status])
}

model AssetPhoto {
  id        String   @id @default(cuid())
  assetId   String
  url       String
  fileName  String
  createdAt DateTime @default(now())
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  @@index([assetId, createdAt])
}

model AssetDocument {
  id                  String             @id @default(cuid())
  assetId             String
  documentType        DocumentType
  displayName         String
  fileUrl             String
  fileName            String
  mimeType            String
  uploadedByUserId    String
  maintenanceRecordId String?
  createdAt           DateTime           @default(now())
  asset               Asset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  maintenanceRecord   MaintenanceRecord? @relation(fields: [maintenanceRecordId], references: [id], onDelete: SetNull)
  @@index([assetId, documentType, createdAt])
  @@index([maintenanceRecordId])
}

model AssetMovement {
  id             String       @id @default(cuid())
  assetId        String
  fromBranchId   String?
  toBranchId     String?
  fromRoomId     String?
  toRoomId       String?
  fromShelfId    String?
  toShelfId      String?
  fromCustodianId  String?
  toCustodianId    String?
  fromDepartmentId String?
  toDepartmentId   String?
  movementType     MovementType
  transferReason   TransferReason?
  note           String?
  movedByUserId  String
  createdAt      DateTime     @default(now())
  asset          Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  movedBy        User         @relation("MovedByUser", fields: [movedByUserId], references: [id], onDelete: Restrict)
  @@index([assetId, createdAt])
  @@index([toBranchId, createdAt])
}

model AssetStatusHistory {
  id         String      @id @default(cuid())
  assetId    String
  fromStatus AssetStatus?
  toStatus   AssetStatus
  note       String?
  createdAt  DateTime    @default(now())
  asset      Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  @@index([assetId, createdAt])
}

model MaintenanceRecord {
  id               String             @id @default(cuid())
  assetId          String
  serviceDate      DateTime
  description      String
  notes            String?
  cost             Decimal?           @db.Decimal(12, 2)
  vendorName       String?
  nextServiceDate  DateTime?
  reportedDate     DateTime?
  sentDate         DateTime?
  actualReturnDate DateTime?
  warrantyClaim    Boolean            @default(false)
  repairOutcome    RepairOutcome?
  status           MaintenanceStatus  @default(COMPLETED)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  asset            Asset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  documents        AssetDocument[]
  @@index([assetId, serviceDate])
  @@index([assetId, status])
}

model ConditionFlag {
  id         String    @id @default(cuid())
  assetId    String
  title      String
  notes      String?
  severity   String
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  asset      Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  @@index([assetId, resolvedAt, createdAt])
}

model ReplacementPolicy {
  id                 String    @id @default(cuid())
  organizationId     String
  categoryId         String
  replacementYears   Int
  disposalGraceMonths Int      @default(6)
  isDefault          Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category           Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  @@unique([organizationId, categoryId])
}

model ReplacementEvaluation {
  id                     String              @id @default(cuid())
  assetId                String
  expectedEndOfLifeDate  DateTime
  recommendedReplaceDate DateTime
  disposalEligibleDate   DateTime
  state                  RecommendationState
  estimatedReplacementCost Decimal          @db.Decimal(12, 2)
  calculatedAt           DateTime            @default(now())
  asset                  Asset               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  @@index([recommendedReplaceDate, state])
  @@index([assetId, calculatedAt])
}

model BudgetForecastSnapshot {
  id                   String   @id @default(cuid())
  organizationId       String
  branchId             String?
  periodStart          DateTime
  periodEnd            DateTime
  totalAssetsDue       Int
  estimatedTotalCost   Decimal  @db.Decimal(14, 2)
  createdAt            DateTime @default(now())
  @@index([organizationId, periodStart, periodEnd])
  @@index([branchId, periodStart])
}

model DisposalRecommendation {
  id                 String                 @id @default(cuid())
  assetId            String
  state              RecommendationState
  recommendedAt      DateTime
  reason             String
  condition          AssetCondition?
  recommendedAction  String?
  approvalStatus     DisposalApprovalStatus @default(PENDING)
  approvedById       String?
  approvedAt         DateTime?
  createdAt          DateTime               @default(now())
  asset              Asset                  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  approvedBy         User?                  @relation("DisposalApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  @@index([assetId, recommendedAt])
  @@index([approvalStatus])
}

model AssignmentAcknowledgement {
  id           String                 @id @default(cuid())
  assetId      String
  userId       String
  status       AcknowledgementStatus  @default(ACCEPTED)
  method       AcknowledgementMethod?
  acceptedAt   DateTime?
  note         String?
  createdAt    DateTime               @default(now())
  asset        Asset                  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user         User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([assetId, acceptedAt])
  @@index([userId, status, createdAt])
  @@index([status, createdAt])
}

model DepreciationRun {
  id             String                @id @default(cuid())
  organizationId String
  periodStart    DateTime
  periodEnd      DateTime
  status         DepreciationRunStatus @default(POSTED)
  notes          String?
  runAt          DateTime              @default(now())
  runByUserId    String
  createdAt      DateTime              @default(now())
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runBy          User                  @relation("DepreciationRunBy", fields: [runByUserId], references: [id], onDelete: Restrict)
  lines          DepreciationRunLine[]
  @@index([organizationId, periodStart, periodEnd])
  @@index([organizationId, runAt])
}

model DepreciationRunLine {
  id                       String             @id @default(cuid())
  runId                    String
  assetId                  String
  ain                      String
  branchId                 String?
  departmentId             String?
  method                   DepreciationMethod
  openingBookValue         Decimal            @db.Decimal(14, 2)
  periodExpense            Decimal            @db.Decimal(14, 2)
  closingBookValue         Decimal            @db.Decimal(14, 2)
  accumulatedDepreciation  Decimal            @db.Decimal(14, 2)
  run                      DepreciationRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  asset                    Asset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  @@index([runId])
  @@index([assetId])
}

model DepreciationPolicy {
  id                   String             @id @default(cuid())
  organizationId       String
  categoryId           String
  method               DepreciationMethod @default(STRAIGHT_LINE)
  usefulLifeYears      Int
  salvagePercent       Decimal            @default(10) @db.Decimal(5, 2)
  decliningRatePercent Decimal?           @db.Decimal(5, 2)
  isDefault            Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category             Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  @@unique([organizationId, categoryId])
}

model AssetDisposalRecord {
  id                    String         @id @default(cuid())
  assetId               String         @unique
  organizationId        String
  method                DisposalMethod
  disposalDate          DateTime
  reason                String
  salePrice             Decimal?       @db.Decimal(12, 2)
  buyerName             String?
  buyerContact          String?
  bookValueAtDisposal   Decimal        @db.Decimal(12, 2)
  recommendedSalePrice  Decimal?       @db.Decimal(12, 2)
  disposedByUserId      String
  createdAt             DateTime       @default(now())
  asset                 Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  organization          Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  disposedBy            User           @relation(fields: [disposedByUserId], references: [id], onDelete: Restrict)
  @@index([organizationId, disposalDate])
  @@index([method, disposalDate])
}

model AssetRequest {
  id                 String              @id @default(cuid())
  requesterId        String
  organizationId     String
  branchId           String
  departmentId       String?
  categoryId         String
  requestedAssetName String
  custodianId        String?
  reason             String
  urgency            AssetRequestUrgency @default(MEDIUM)
  notes              String?
  status             AssetRequestStatus  @default(PENDING)
  reviewerId         String?
  reviewComment      String?
  reviewedAt         DateTime?
  fulfilledAssetId   String?             @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  requester          User                @relation("AssetRequestRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  reviewer           User?               @relation("AssetRequestReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  custodian          User?               @relation("AssetRequestCustodian", fields: [custodianId], references: [id], onDelete: SetNull)
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch             Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department         Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  category           Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  fulfilledAsset     Asset?              @relation(fields: [fulfilledAssetId], references: [id], onDelete: SetNull)
  @@index([organizationId, status, createdAt])
  @@index([branchId, status])
  @@index([requesterId, createdAt])
  @@index([custodianId])
}

model Permission {
  id          String           @id @default(cuid())
  role        UserRole
  key         String
  effect      PermissionEffect @default(ALLOW)
  createdAt   DateTime         @default(now())
  @@unique([role, key])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  organizationId String?
  branchId     String?
  action       String
  entityType   String
  entityId     String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  actor        User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  @@index([organizationId, createdAt])
  @@index([branchId, createdAt])
  @@index([entityType, entityId])
}

model ReminderSchedule {
  id             String       @id @default(cuid())
  organizationId String
  reminderType   ReminderType
  targetDate     DateTime
  payload        Json
  sentAt         DateTime?
  createdAt      DateTime     @default(now())
  @@index([organizationId, reminderType, targetDate])
}

model NotificationLog {
  id        String   @id @default(cuid())
  userId    String
  type      String
  subject   String
  body      String
  sentAt    DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, sentAt])
}

model ImportJob {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String?
  createdByUserId String
  fileName       String
  totalRows      Int
  successRows    Int      @default(0)
  failedRows     Int      @default(0)
  status         String
  errorReport    Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([organizationId, createdAt])
}

model VerificationCampaign {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  description    String?
  status         CampaignStatus @default(DRAFT)
  startDate      DateTime
  endDate        DateTime
  branchIds      String[]       @default([])
  departmentIds  String[]       @default([])
  categoryIds    String[]       @default([])
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User           @relation("CampaignCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignments    CampaignAssignment[]
  snapshots      CampaignScopeSnapshot[]
  verifications  AssetVerification[]
  exceptions     AssetException[]
  @@index([organizationId, status])
}

model CampaignAssignment {
  id         String               @id @default(cuid())
  campaignId String
  userId     String
  branchId   String?
  createdAt  DateTime             @default(now())
  campaign   VerificationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch     Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  @@unique([campaignId, userId, branchId])
  @@index([userId])
}

model CampaignScopeSnapshot {
  id         String               @id @default(cuid())
  campaignId String
  assetId    String
  campaign   VerificationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  asset      Asset                @relation(fields: [assetId], references: [id], onDelete: Cascade)
  @@unique([campaignId, assetId])
  @@index([campaignId])
}

model AssetVerification {
  id             String               @id @default(cuid())
  campaignId     String
  assetId        String?
  organizationId String
  outcome        VerificationOutcome
  verifiedAt     DateTime             @default(now())
  verifiedById   String
  locationNote   String?
  condition      AssetCondition?
  photoUrl       String?
  notes          String?
  notFoundReason NotFoundReason?
  lastKnownLocation String?
  campaign       VerificationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  asset          Asset?               @relation(fields: [assetId], references: [id], onDelete: SetNull)
  verifiedBy     User                 @relation("VerifiedBy", fields: [verifiedById], references: [id], onDelete: Restrict)
  @@unique([campaignId, assetId])
  @@index([campaignId, outcome])
  @@index([assetId])
}

model AssetException {
  id              String          @id @default(cuid())
  organizationId  String
  campaignId      String?
  assetId         String?
  branchId        String?
  type            ExceptionType
  status          ExceptionStatus @default(IDENTIFIED)
  identifiedById  String
  identifiedAt    DateTime        @default(now())
  assignedToId    String?
  dueDate         DateTime?
  description     String
  resolution      String?
  resolvedAt      DateTime?
  approvedById    String?
  approvedAt      DateTime?
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign        VerificationCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  asset           Asset?          @relation(fields: [assetId], references: [id], onDelete: SetNull)
  identifiedBy    User            @relation("ExceptionIdentifier", fields: [identifiedById], references: [id], onDelete: Restrict)
  assignedTo      User?           @relation("ExceptionAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  approvedBy      User?           @relation("ExceptionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  evidence        ExceptionEvidence[]
  events          ExceptionEvent[]
  @@index([organizationId, status])
  @@index([campaignId, assetId, type])
}

model ExceptionEvent {
  id          String          @id @default(cuid())
  exceptionId String
  fromStatus  ExceptionStatus?
  toStatus    ExceptionStatus
  actorId     String
  note        String?
  createdAt   DateTime        @default(now())
  exception   AssetException  @relation(fields: [exceptionId], references: [id], onDelete: Cascade)
  actor       User            @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([exceptionId, createdAt])
}

model ExceptionEvidence {
  id           String         @id @default(cuid())
  exceptionId  String
  fileName     String
  fileUrl      String
  uploadedById String
  createdAt    DateTime       @default(now())
  exception    AssetException @relation(fields: [exceptionId], references: [id], onDelete: Cascade)
  uploadedBy   User           @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  @@index([exceptionId])
}

model HealthAssessment {
  id             String   @id @default(cuid())
  organizationId String
  version        Int      @default(1)
  scores         Json
  overall        Decimal  @db.Decimal(5, 2)
  maturityLevel  Int
  strengths      String?
  weaknesses     String?
  actions        String?
  createdById    String
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("HealthAssessmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  recommendations HealthRecommendation[]
  @@index([organizationId, createdAt])
}

model HealthRecommendation {
  id             String   @id @default(cuid())
  assessmentId   String
  title          String
  priority       String
  ownerName      String?
  targetDate     DateTime?
  status         String   @default("OPEN")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  assessment     HealthAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  @@index([assessmentId, status])
}
